# ============================================================
# Variables de entorno de EduPartner
# Copia estos nombres en Vercel → Settings → Environment Variables.
# NUNCA subas los valores reales al repositorio.
# ============================================================

# Access Token de Mercado Pago (privado).
# Para pruebas usa el de "Credenciales de prueba"; en producción el de
# "Credenciales de producción". Empieza con APP_USR-... o TEST-...
MP_ACCESS_TOKEN=

# Clave secreta para ver la lista de participantes en /api/admin
# Inventa una larga y aleatoria, ej: a9F3k...x7Q
ADMIN_KEY=

# URL pública del sitio. Con dominio propio, ponla para que las URLs de
# retorno de Mercado Pago usen tu dominio. Ej: https://edupartner.cl
PUBLIC_BASE_URL=

# --- Email de confirmación (Resend) ---
# API key de https://resend.com (empieza con re_...). Si no la pones,
# el sistema funciona igual pero no envía el correo.
RESEND_API_KEY=

# Remitente del correo. Debe ser de un dominio verificado en Resend.
# Mientras verificas tu dominio puedes dejarlo en blanco (usa onboarding@resend.dev,
# que solo envía a tu propio correo, para pruebas).
# Ej cuando edupartner.cl esté verificado: EduPartner <sorteos@edupartner.cl>
MAIL_FROM=

# --- Base de datos (Vercel Postgres) ---
# Estas las inyecta Vercel automáticamente al conectar el almacenamiento
# Postgres al proyecto. NO necesitas escribirlas a mano:
#   POSTGRES_URL=
#   POSTGRES_PRISMA_URL=
#   POSTGRES_URL_NON_POOLING=

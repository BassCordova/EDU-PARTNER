# ============================================================
# Variables de entorno de EduPartner
# Copia estos nombres en Vercel → Settings → Environment Variables.
# NUNCA subas los valores reales al repositorio.
# ============================================================

# Access Token de Mercado Pago (privado).
# Para pruebas usa el de "Credenciales de prueba"; en producción el de
# "Credenciales de producción". Empieza con APP_USR-... o TEST-...
MP_ACCESS_TOKEN=

# Clave secreta para ver la lista de participantes en /api/admin
# Inventa una larga y aleatoria, ej: a9F3k...x7Q
ADMIN_KEY=

# (Opcional) URL pública del sitio. Si no se define, se detecta sola.
# Útil si usas un dominio propio. Ej: https://edupartner.cl
# PUBLIC_BASE_URL=

# --- Base de datos (Vercel Postgres) ---
# Estas las inyecta Vercel automáticamente al conectar el almacenamiento
# Postgres al proyecto. NO necesitas escribirlas a mano:
#   POSTGRES_URL=
#   POSTGRES_PRISMA_URL=
#   POSTGRES_URL_NON_POOLING=
